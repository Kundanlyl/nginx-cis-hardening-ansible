# Managed by Ansible

# CIS 4.1.1
server {
    listen 80;
    listen [::]:80;

    server_name {{ nginx_cis_server_names | join(' ') }};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name {{ nginx_cis_server_names | join(' ') }};

    root /var/www/html;
    index index.html;

    # CIS 4.1.3
    ssl_certificate {{ nginx_cis_tls_certificate }};
    ssl_certificate_key {{ nginx_cis_tls_private_key }};

    # CIS 4.1.4 and 4.1.5
    # TLS 1.3 exclusively provides modern AEAD cipher suites.
    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;

    # CIS 4.1.11
    ssl_session_tickets on;
    
    # CIS 4.1.8
    add_header Strict-Transport-Security
        "max-age={{ nginx_cis_hsts_max_age }}; includeSubDomains"
        always;

    # CIS 5.3.1, 5.3.2 and 5.3.3
    include /etc/nginx/snippets/cis-security-headers.conf;

    # CIS 2.5.3
    include /etc/nginx/snippets/cis-deny-hidden.conf;

    # CIS 5.1.2
    location / {
        # In NGINX, allowing GET also permits HEAD.
        limit_except GET {
            deny all;
        }

        try_files $uri $uri/ =404;
    }

    # CIS 5.1.2 and 5.2.5
    location = /login {
        limit_except GET {
            deny all;
        }

        limit_req zone=cis_login_limit
                  burst={{ nginx_cis_login_burst }}
                  nodelay;
        limit_req_status 429;

        try_files /index.html =404;
    }
}
